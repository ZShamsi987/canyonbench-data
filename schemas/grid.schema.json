{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZShamsi987/canyonbench-data/schemas/grid.schema.json",
  "title": "CanyonBench 4x4 grounding-grid annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "annotator", "cells"],
  "properties": {
    "image": {"type": "string", "pattern": "^img_[0-9]{6,}\\.jpg$"},
    "annotator": {"type": "string", "minLength": 1, "maxLength": 32},
    "cells": {
      "type": "object",
      "additionalProperties": false,
      "required": ["0,0", "0,1", "0,2", "0,3", "1,0", "1,1", "1,2", "1,3", "2,0", "2,1", "2,2", "2,3", "3,0", "3,1", "3,2", "3,3"],
      "properties": {
        "0,0": {"type": "boolean"}, "0,1": {"type": "boolean"},
        "0,2": {"type": "boolean"}, "0,3": {"type": "boolean"},
        "1,0": {"type": "boolean"}, "1,1": {"type": "boolean"},
        "1,2": {"type": "boolean"}, "1,3": {"type": "boolean"},
        "2,0": {"type": "boolean"}, "2,1": {"type": "boolean"},
        "2,2": {"type": "boolean"}, "2,3": {"type": "boolean"},
        "3,0": {"type": "boolean"}, "3,1": {"type": "boolean"},
        "3,2": {"type": "boolean"}, "3,3": {"type": "boolean"}
      }
    }
  }
}
