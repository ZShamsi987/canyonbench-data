{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ZShamsi987/canyonbench-data/schemas/quality.schema.json",
  "title": "CanyonBench quality and condition annotation",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "annotator", "cloud", "clarity", "balloon", "sharpness", "exposure", "glare"],
  "properties": {
    "image": {"type": "string", "pattern": "^img_[0-9]{6,}\\.jpg$"},
    "annotator": {"type": "string", "minLength": 1, "maxLength": 32},
    "cloud": {"enum": ["none", "partial", "heavy"]},
    "clarity": {"enum": ["clear", "moderate", "heavy"]},
    "balloon": {"enum": ["none", "partial"]},
    "sharpness": {"enum": ["sharp", "blurred"]},
    "exposure": {"enum": ["ok", "over", "under"]},
    "glare": {"enum": ["none", "present"]}
  }
}
